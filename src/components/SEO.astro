---
// ════════════════════════════════════════════════════════════
// SEO — metadatos del <head>: título, description, canonical,
// Open Graph, Twitter card, theme-color, RSS y JSON-LD.
// Lo usa Layout.astro; las páginas solo pasan sus props al Layout.
// Todas las URLs absolutas se derivan de `site` (astro.config.mjs).
// ════════════════════════════════════════════════════════════
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { seo } from "../data/seo";
import { site as profile, socials } from "../data/site";

export interface Props {
    /** Título de la página, sin el sufijo "// alias" (lo añade la plantilla). */
    title: string;
    /** Description propia de la página (si falta, la del sitio). */
    description?: string;
    /** Imagen OG: import de astro:assets (se optimiza) o ruta/URL. */
    image?: ImageMetadata | string;
    imageAlt?: string;
    type?: "website" | "article";
    /** Solo artículos. */
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
    /** Excluye la página de buscadores (p. ej. la 404). */
    noindex?: boolean;
    /** Color de superficie de cada slot de tema, para <meta name="theme-color">. */
    themeColors: { light: string; dark: string };
}

const {
    title,
    description = seo.description,
    image,
    imageAlt,
    type = "website",
    publishedTime,
    modifiedTime,
    tags = [],
    noindex = false,
    themeColors,
} = Astro.props;

const base = Astro.site ?? new URL(Astro.url.origin);
const abs = (path: string) => new URL(path, base).href;

const fullTitle = `${title}${seo.titleSeparator}${seo.siteName}`;

// Canonical con barra final (build.format "directory"), igual que el sitemap.
let pathname = Astro.url.pathname;
if (!pathname.endsWith("/") && !/\.[a-z0-9]+$/i.test(pathname)) {
    pathname += "/";
}
const canonical = abs(pathname);

// Imagen OG: la portada optimizada si existe; si no, la del sitio.
let og = {
    url: abs(seo.image.src),
    width: seo.image.width as number | undefined,
    height: seo.image.height as number | undefined,
    type: seo.image.type as string | undefined,
    alt: seo.image.alt as string,
};
if (image && typeof image !== "string") {
    // 1200 px de ancho (lo que piden las cards), sin ampliar portadas pequeñas.
    const width = Math.min(1200, image.width);
    const optimized = await getImage({ src: image, width, format: "jpg" });
    og = {
        url: abs(optimized.src),
        width: Number(optimized.attributes.width) || undefined,
        height: Number(optimized.attributes.height) || undefined,
        type: "image/jpeg",
        alt: imageAlt ?? title,
    };
} else if (typeof image === "string") {
    og = { url: abs(image), width: undefined, height: undefined, type: undefined, alt: imageAlt ?? title };
}

// ── JSON-LD ──
const person = {
    "@type": "Person",
    "@id": abs("/#person"),
    name: profile.alias,
    url: abs("/"),
    sameAs: socials.map((s) => s.href),
};
const isHome = Astro.url.pathname === "/";
const jsonLd =
    type === "article"
        ? {
              "@context": "https://schema.org",
              "@type": "BlogPosting",
              headline: title,
              description,
              url: canonical,
              mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
              image: [og.url],
              datePublished: publishedTime?.toISOString(),
              dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
              author: person,
              keywords: tags.length ? tags.join(", ") : undefined,
              inLanguage: seo.lang,
          }
        : isHome
          ? {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "WebSite",
                        "@id": abs("/#website"),
                        url: abs("/"),
                        name: seo.siteName,
                        description,
                        inLanguage: seo.lang,
                        author: { "@id": person["@id"] },
                    },
                    person,
                ],
            }
          : null;
// Escapa "<" para que el JSON no pueda cerrar el <script>.
const jsonLdHtml = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.alias} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<!-- theme-color: valor inicial por preferencia del SO; el script anti-FOUC
     y el toggle lo ajustan al tema activo (data-light / data-dark). -->
<meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content={themeColors.light}
    data-light={themeColors.light}
    data-dark={themeColors.dark}
/>
<meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content={themeColors.dark}
    data-light={themeColors.light}
    data-dark={themeColors.dark}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={seo.siteName} />
<meta property="og:locale" content={seo.locale} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={og.url} />
{og.type && <meta property="og:image:type" content={og.type} />}
{og.width && <meta property="og:image:width" content={String(og.width)} />}
{og.height && <meta property="og:image:height" content={String(og.height)} />}
<meta property="og:image:alt" content={og.alt} />
{
    type === "article" && (
        <>
            {publishedTime && (
                <meta property="article:published_time" content={publishedTime.toISOString()} />
            )}
            {(modifiedTime ?? publishedTime) && (
                <meta
                    property="article:modified_time"
                    content={(modifiedTime ?? publishedTime)!.toISOString()}
                />
            )}
            <meta property="article:author" content={abs("/")} />
            {tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
    )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og.url} />
<meta name="twitter:image:alt" content={og.alt} />

<!-- Descubribilidad -->
<link rel="alternate" type="application/rss+xml" title={seo.rss.title} href={abs(seo.rss.path)} />
<link rel="sitemap" href={abs("/sitemap-index.xml")} />

{jsonLdHtml && <script type="application/ld+json" is:inline set:html={jsonLdHtml} />}
