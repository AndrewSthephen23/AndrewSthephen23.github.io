---
// Avatar — foto de "Who am I?".
// Con `site.avatar` (archivo en src/assets/) muestra la imagen optimizada
// con <Image />. Sin ella, dibuja un avatar generado: un gato pixel-art
// (por el alias, M3ow5N0IR) en una "terminal" con los tokens del tema.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../data/site";

const files = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/*.{png,jpg,jpeg,webp,avif}",
    { eager: true },
);

let photo: ImageMetadata | undefined;
if (site.avatar) {
    const mod = files[`/src/assets/${site.avatar}`];
    if (!mod) {
        throw new Error(
            `[site] No existe src/assets/${site.avatar} (campo "avatar" en src/data/site.ts).`,
        );
    }
    photo = mod.default;
}

// Mapa del gato: # cuerpo · s oreja · o ojo · p nariz · w bigote · . vacío
const CAT = [
    "..#..........#..",
    "..##........##..",
    "..#s#......#s#..",
    "..############..",
    ".##############.",
    ".###oo####oo###.",
    ".###oo####oo###.",
    "w##############w",
    ".######pp######.",
    "w#####.##.#####w",
    ".##############.",
    "..############..",
    "...##########...",
];

// Clases literales (Tailwind) por tipo de píxel: todo sale del tema.
const FILL: Record<string, string> = {
    "#": "fill-box-ink",
    s: "fill-secondary",
    o: "fill-info",
    p: "fill-secondary",
    w: "fill-box-muted",
};

const pixels = CAT.flatMap((row, y) =>
    [...row].flatMap((c, x) => (FILL[c] ? [{ x, y, cls: FILL[c] }] : [])),
);
const alias = site.alias.toLowerCase();
---

<div
    class="aspect-square bg-soft border-4 border-ink relative shadow-hard overflow-hidden group"
>
    {
        photo ? (
            <>
                <Image
                    src={photo}
                    alt={site.avatarAlt || `Foto de ${site.alias}`}
                    widths={[320, 640, 960]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    loading="lazy"
                    class="w-full h-full object-cover"
                />
                <span
                    class="absolute top-2 left-2 bg-danger text-on-accent px-2 font-mono text-xs border border-ink z-10"
                    aria-hidden="true"
                >
                    ROOT.JPG
                </span>
            </>
        ) : (
            <div
                class="w-full h-full bg-box text-box-ink font-mono flex flex-col relative"
                role="img"
                aria-label={`Avatar pixel-art: un gato, por el alias ${site.alias}`}
            >
                <div
                    class="absolute inset-0 opacity-60"
                    style="background-image: linear-gradient(var(--t-box-line) 1px, transparent 1px), linear-gradient(90deg, var(--t-box-line) 1px, transparent 1px); background-size: 24px 24px;"
                    aria-hidden="true"
                />
                <div class="relative flex items-center justify-between border-b border-box-line px-3 py-2 text-xs">
                    <span class="bg-danger text-on-accent px-2 font-bold border border-ink">
                        WHOAMI.SVG
                    </span>
                    <span class="flex gap-1.5" aria-hidden="true">
                        <span class="h-2.5 w-2.5 rounded-full bg-danger" />
                        <span class="h-2.5 w-2.5 rounded-full bg-warning" />
                        <span class="h-2.5 w-2.5 rounded-full bg-success" />
                    </span>
                </div>
                <p class="relative px-3 pt-3 text-sm" aria-hidden="true">
                    <span class="text-success">root@{alias}</span>:<span class="text-info">~</span>$ whoami
                </p>
                <div class="relative flex-1 flex items-center justify-center p-4">
                    <svg
                        viewBox="0 0 16 13"
                        class="w-3/5 max-w-[240px] h-auto transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105"
                        shape-rendering="crispEdges"
                        aria-hidden="true"
                        focusable="false"
                    >
                        {pixels.map((p) => (
                            <rect x={p.x} y={p.y} width="1" height="1" class={p.cls} />
                        ))}
                    </svg>
                </div>
                <p class="relative px-3 pb-3 text-sm font-bold" aria-hidden="true">
                    &gt; {site.alias}
                    <span class="inline-block w-2.5 h-4 align-middle bg-success animate-pulse" />
                </p>
            </div>
        )
    }
</div>
