---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import SEO from "../components/SEO.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import MobileMenu from "../components/MobileMenu.astro";
import { site, socials } from "../data/site";
import { seo } from "../data/seo";
import { navLinks, navCta, ariaCurrent } from "../data/nav";
import { themeToken } from "../lib/theme";

interface Props {
    /** Título de la página; la plantilla añade " // alias". */
    title: string;
    /** Description propia de la página (SEO y tarjetas al compartir). */
    description?: string;
    /** Imagen OG (portada de astro:assets o ruta); por defecto la del sitio. */
    image?: ImageMetadata | string;
    imageAlt?: string;
    type?: "website" | "article";
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
    noindex?: boolean;
}

const { title, ...seoProps } = Astro.props;

// ══ CONFIG DE TEMAS (LEGO) ══════════════════════════════════════
// Cada slot apunta a una pieza de src/styles/themes/.
// Para cambiar de pieza: 1) importa el tema en global.css,
// 2) cambia el nombre del slot aquí. Ver docs/GUIA_TEMAS.md.
const THEME_SLOTS = { light: "dev", dark: "hacker" };
// ════════════════════════════════════════════════════════════════

// Color de superficie de cada slot, leído del token --t-surface de su pieza.
function surfaceOf(theme: string): string {
    const color = themeToken(theme, "surface");
    if (!color) throw new Error(`El tema "${theme}" no define --t-surface`);
    return color;
}
const themeColors = {
    light: surfaceOf(THEME_SLOTS.light),
    dark: surfaceOf(THEME_SLOTS.dark),
};

---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- Iconos: generados por scripts/generate-brand-assets.mjs (npm run brand) -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <SEO title={title} themeColors={themeColors} {...seoProps} />
        <!-- Anti-FOUC: fija el tema antes de pintar (los slots vienen del frontmatter). -->
        <script is:inline define:vars={{ THEME_SLOTS }}>
            const root = document.documentElement;
            root.dataset.themeLight = THEME_SLOTS.light;
            root.dataset.themeDark = THEME_SLOTS.dark;

            let theme = null;
            try {
                theme = localStorage.getItem("theme");
            } catch {
                /* almacenamiento bloqueado: se usa la preferencia del SO */
            }
            if (theme !== THEME_SLOTS.light && theme !== THEME_SLOTS.dark) {
                theme = window.matchMedia("(prefers-color-scheme: dark)")
                    .matches
                    ? THEME_SLOTS.dark
                    : THEME_SLOTS.light;
            }
            const mode = theme === THEME_SLOTS.dark ? "dark" : "light";
            root.dataset.theme = theme;
            root.dataset.mode = mode;

            // theme-color del tema activo (valores en data-light / data-dark).
            document
                .querySelectorAll('meta[name="theme-color"]')
                .forEach((m) => m.setAttribute("content", m.dataset[mode]));
        </script>
    </head>
    <body
        class="font-display antialiased selection:bg-ink selection:text-surface"
    >
        <div id="cursor" class="hidden lg:block"></div>

        <div
            class="fixed top-0 left-0 h-2 bg-success z-[60] border-b-2 border-ink"
            id="progressBar"
            style="width: 0%"
        >
        </div>

        <!-- Saltar al contenido: fuera de pantalla hasta recibir foco.
             El destino <main id="main"> lo añade la Fase 5. -->
        <a
            href="#main"
            class="fixed top-4 left-4 z-[70] -translate-y-[200%] focus:translate-y-0 bg-primary text-on-accent border-2 border-ink px-4 py-2 font-mono font-bold shadow-hard"
            >Saltar al contenido</a
        >

        <nav
            aria-label="Principal"
            class="fixed top-0 w-full z-50 px-4 py-4 pointer-events-none"
        >
            <div
                class="max-w-7xl mx-auto flex justify-between items-center gap-3 pointer-events-auto"
            >
                <a
                    href="/"
                    class="bg-panel border-2 border-ink px-4 py-1 text-2xl font-black shadow-hard hover:bg-primary hover:text-on-accent transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-none cursor-hover"
                >
                    {site.alias}.exe
                </a>

                <div class="flex items-center gap-3">
                    <ul
                        class="hidden md:flex gap-4 bg-panel border-2 border-ink p-2 shadow-hard"
                    >
                        {
                            navLinks.map((link) => {
                                const current = ariaCurrent(link, Astro.url.pathname);
                                return (
                                    <li class="flex">
                                        <a
                                            href={link.href}
                                            aria-current={current}
                                            class:list={[
                                                "px-3 py-1 font-mono font-bold text-sm transition-colors cursor-hover",
                                                current
                                                    ? "bg-ink text-surface"
                                                    : "hover:bg-ink hover:text-surface",
                                            ]}
                                        >
                                            {link.label}
                                        </a>
                                    </li>
                                );
                            })
                        }
                        <li class="flex">
                            <a
                                href={navCta.href}
                                class="px-3 py-1 font-mono font-bold text-sm bg-primary text-on-accent border border-ink hover:bg-secondary transition-colors cursor-hover"
                                >{navCta.label}</a
                            >
                        </li>
                    </ul>

                    <!-- En móvil el toggle vive dentro del menú -->
                    <ThemeToggle
                        class="hidden md:inline-block bg-panel border-2 border-ink px-3 py-2 font-mono font-bold text-sm shadow-hard hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                    />

                    <MobileMenu />
                </div>
            </div>
        </nav>

        <slot />

        <footer
            class="bg-box text-box-ink py-16 px-4 border-t-8 border-success font-mono relative overflow-hidden"
        >
            <div
                class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 relative z-10"
            >
                <div class="col-span-1 md:col-span-2">
                    <h2 class="text-4xl font-black mb-6">{site.alias}.</h2>
                    <p class="text-box-muted max-w-sm">
                        Resolviendo máquinas y construyendo sistemas con
                        estética cruda y código limpio.
                    </p>
                </div>
                <div>
                    <h3
                        class="font-bold text-success mb-4 border-b border-box-line pb-2"
                    >
                        SOCIALS
                    </h3>
                    <!-- Redes desde src/data/site.ts: solo las que tienen URL -->
                    <div class="flex gap-4">
                        {
                            socials.map((s) => (
                                <a
                                    href={s.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={s.label}
                                    title={s.label}
                                    class="inline-flex text-2xl hover:text-primary transition-colors cursor-hover"
                                >
                                    <Icon name={s.icon} aria-hidden="true" />
                                </a>
                            ))
                        }
                        {
                            site.email && (
                                <a
                                    href={`mailto:${site.email}`}
                                    aria-label="Email"
                                    title="Email"
                                    class="inline-flex text-2xl hover:text-info transition-colors cursor-hover"
                                >
                                    <Icon name="ri:mail-line" aria-hidden="true" />
                                </a>
                            )
                        }
                    </div>
                </div>
                <div>
                    <h3
                        class="font-bold text-success mb-4 border-b border-box-line pb-2"
                    >
                        FEED
                    </h3>
                    <a
                        href={seo.rss.path}
                        class="inline-flex items-center gap-2 hover:text-primary transition-colors cursor-hover"
                    >
                        <Icon name="ri:rss-fill" aria-hidden="true" class="text-2xl" />
                        RSS de write-ups
                    </a>
                </div>
            </div>
            <div
                class="text-center mt-16 pt-8 border-t border-box-line text-box-muted text-sm"
            >
                <p>© 2026 // SYSTEM_END</p>
            </div>
            <div
                aria-hidden="true"
                class="absolute bottom-0 left-0 w-full text-[20vw] font-black text-box-ink opacity-[0.03] leading-none select-none pointer-events-none text-center"
            >
                BRUTAL
            </div>
        </footer>

        <script>
            // (El toggle de tema vive en src/components/ThemeToggle.astro)

            // ── Cursor personalizado (los colores viven en CSS/temas)
            const cursor = document.getElementById("cursor");
            if (cursor) {
                document.addEventListener("mousemove", (e) => {
                    cursor.style.left = e.clientX + "px";
                    cursor.style.top = e.clientY + "px";
                });

                const hoverElements = document.querySelectorAll(
                    ".cursor-hover, a, button, input, textarea",
                );
                hoverElements.forEach((el) => {
                    el.addEventListener("mouseenter", () =>
                        cursor.classList.add("is-hover"),
                    );
                    el.addEventListener("mouseleave", () =>
                        cursor.classList.remove("is-hover"),
                    );
                });
            }

            // ── Scroll Reveal
            const revealElements = document.querySelectorAll(".reveal");
            const revealObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("active");
                        }
                    });
                },
                { threshold: 0.1 },
            );
            revealElements.forEach((el) => revealObserver.observe(el));

            // ── Barra de progreso
            window.addEventListener("scroll", () => {
                let winScroll =
                    document.body.scrollTop ||
                    document.documentElement.scrollTop;
                let height =
                    document.documentElement.scrollHeight -
                    document.documentElement.clientHeight;
                let scrolled = (winScroll / height) * 100;
                const progress = document.getElementById("progressBar");
                if (progress) progress.style.width = scrolled + "%";
            });
        </script>
    </body>
</html>
