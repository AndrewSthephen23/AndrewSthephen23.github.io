---
// ════════════════════════════════════════════════════════════
// MENÚ MÓVIL (< md): botón hamburguesa + panel full-screen.
// Patrón "disclosure": <button aria-expanded aria-controls> que muestra
// el panel. Mientras está abierto: foco atrapado (botón + panel), scroll
// del body bloqueado, cierre con Esc, con el botón o al pulsar un enlace.
// Va dentro del <nav> del Layout; el panel queda por debajo de la barra
// superior (logo + botón), que sigue visible para poder cerrarlo.
// ════════════════════════════════════════════════════════════
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";
import { navLinks, navCta, ariaCurrent } from "../data/nav";

const pathname = Astro.url.pathname;
---

<button
    type="button"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="mobile-menu"
    class="menu-toggle md:hidden inline-flex items-center gap-2 bg-panel border-2 border-ink px-3 py-2 font-mono font-bold text-sm shadow-hard hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
>
    <Icon name="ri:menu-line" aria-hidden="true" class="menu-icon-open text-xl" />
    <Icon name="ri:close-line" aria-hidden="true" class="menu-icon-close text-xl" />
    <span class="max-[379px]:sr-only">MENU</span>
</button>

<div id="mobile-menu" class="mobile-menu md:hidden" data-mobile-menu>
    <div class="px-4 pt-28 pb-10 max-w-md mx-auto">
        <p class="font-mono text-sm text-muted mb-6">
            <span class="text-ink font-bold">~$</span> ls /nav
        </p>
        <ul class="flex flex-col gap-4">
            {
                navLinks.map((link, i) => {
                    const current = ariaCurrent(link, pathname);
                    return (
                        <li style={`--i: ${i}`}>
                            <a
                                href={link.href}
                                aria-current={current}
                                class:list={[
                                    "flex items-baseline gap-3 border-4 border-ink px-5 py-3 text-3xl font-black uppercase tracking-tight shadow-hard transition-colors cursor-hover",
                                    current
                                        ? "bg-ink text-surface"
                                        : "bg-panel text-ink hover:bg-ink hover:text-surface",
                                ]}
                            >
                                <span class="font-mono text-sm font-bold opacity-70" aria-hidden="true">
                                    {String(i + 1).padStart(2, "0")}
                                </span>
                                {link.label}
                            </a>
                        </li>
                    );
                })
            }
            <li style={`--i: ${navLinks.length}`}>
                <a
                    href={navCta.href}
                    class="flex items-center justify-between border-4 border-ink bg-primary text-on-accent px-5 py-3 text-3xl font-black uppercase tracking-tight shadow-hard hover:bg-secondary transition-colors cursor-hover"
                >
                    {navCta.label}
                    <Icon name="ri:arrow-right-line" aria-hidden="true" />
                </a>
            </li>
            <li style={`--i: ${navLinks.length + 1}`} class="mt-4">
                <ThemeToggle
                    class="w-full bg-panel text-ink border-4 border-ink px-5 py-3 font-mono font-bold text-xl shadow-hard hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                />
            </li>
        </ul>
    </div>
</div>

<style>
    /* Panel a pantalla completa por debajo de la barra del nav (z-index
       negativo dentro del contexto de apilamiento del <nav> fijo). */
    .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: auto;
        overflow-y: auto;
        overscroll-behavior: contain;
        background-color: var(--t-surface);
        background-image:
            linear-gradient(to right, var(--t-grid) 1px, transparent 1px),
            linear-gradient(to bottom, var(--t-grid) 1px, transparent 1px);
        background-size: 100px 100px;
        visibility: hidden;
        opacity: 0;
    }

    .mobile-menu[data-open] {
        visibility: visible;
        opacity: 1;
    }

    /* Icono del botón según el estado */
    .menu-toggle[aria-expanded="true"] .menu-icon-open,
    .menu-toggle[aria-expanded="false"] .menu-icon-close {
        display: none;
    }

    .menu-toggle[aria-expanded="true"] {
        background-color: var(--t-primary);
        color: var(--t-on-accent);
    }

    /* Bloqueo de scroll del documento mientras el menú está abierto */
    :global(html[data-menu-open]) {
        overflow: hidden;
    }

    /* Animaciones solo si el usuario no pidió reducir movimiento */
    @media (prefers-reduced-motion: no-preference) {
        .mobile-menu {
            transform: translateY(-1rem);
            transition:
                opacity 0.2s ease,
                transform 0.2s ease,
                visibility 0s linear 0.2s;
        }

        .mobile-menu[data-open] {
            transform: none;
            transition:
                opacity 0.2s ease,
                transform 0.2s ease,
                visibility 0s;
        }

        .mobile-menu[data-open] li {
            animation: menu-item-in 0.25s ease both;
            animation-delay: calc(var(--i, 0) * 40ms);
        }

        @keyframes menu-item-in {
            from {
                opacity: 0;
                transform: translateX(-1.5rem);
            }
        }
    }
</style>

<script>
    const btn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-mobile-menu]");

    if (btn && panel) {
        const html = document.documentElement;
        const desktop = window.matchMedia("(min-width: 48rem)");
        let open = false;

        // Orden del ciclo de foco: botón → enlaces y botones del panel.
        const focusables = () => [
            btn,
            ...panel.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
        ];

        function onKeydown(e: KeyboardEvent) {
            if (e.key === "Escape") {
                e.preventDefault();
                setOpen(false);
                return;
            }
            if (e.key !== "Tab") return;

            const items = focusables();
            const first = items[0];
            const last = items[items.length - 1];
            const active = document.activeElement as HTMLElement | null;

            if (!active || !items.includes(active)) {
                e.preventDefault();
                (e.shiftKey ? last : first).focus();
            } else if (e.shiftKey && active === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && active === last) {
                e.preventDefault();
                first.focus();
            }
        }

        function setOpen(next: boolean, restoreFocus = true) {
            if (!btn || !panel || next === open) return;
            open = next;
            btn.setAttribute("aria-expanded", String(next));
            panel.toggleAttribute("data-open", next);
            html.toggleAttribute("data-menu-open", next);

            if (next) {
                document.addEventListener("keydown", onKeydown);
                panel.querySelector<HTMLElement>("a[href]")?.focus();
            } else {
                document.removeEventListener("keydown", onKeydown);
                if (restoreFocus) btn.focus();
            }
        }

        btn.addEventListener("click", () => setOpen(!open));

        // Al pulsar un enlace se cierra (sin robar el foco a la navegación).
        panel.querySelectorAll("a[href]").forEach((a) =>
            a.addEventListener("click", () => setOpen(false, false)),
        );

        // Si la ventana pasa a escritorio con el menú abierto, se cierra.
        desktop.addEventListener("change", (e) => {
            if (e.matches) setOpen(false, false);
        });
    }
</script>
