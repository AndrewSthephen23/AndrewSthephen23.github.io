---

<section
    id="skills"
    class="py-20 bg-neo-black text-neo-white border-y-4 border-black relative overflow-hidden"
>
    <div
        class="absolute inset-0 opacity-20"
        style="background-image: linear-gradient(#333 1px, transparent 1px), linear-gradient(90deg, #333 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>

    <div class="max-w-[1400px] mx-auto px-4 relative z-10">
        <div
            class="flex flex-col md:flex-row justify-between items-end mb-12 border-b-4 border-white pb-4"
        >
            <h2
                class="text-6xl md:text-8xl font-black uppercase text-white tracking-tighter"
            >
                TECH<span class="text-neo-green">_STACK</span>
            </h2>
            <div class="flex items-center gap-2 mb-2 md:mb-4">
                <div
                    class="w-3 h-3 bg-red-500 rounded-full animate-pulse border border-black"
                >
                </div>
                <p class="font-mono text-neo-green text-sm font-bold">
                    /// SYSTEM_OPTIMIZED
                </p>
            </div>
        </div>

        <div class="flex flex-wrap justify-center md:justify-start">
            {
                skills.map((skill) => (
                    <div
                        class={`group w-1/2 sm:w-1/3 md:w-1/4 lg:w-1/6 xl:w-[12.5%] h-24 border-r-2 border-b-2 border-white/20 bg-neo-black transition-all duration-0 hover:z-10 relative cursor-hover flex flex-col items-center justify-center p-2 ${skill.hover}`}
                    >
                        <div
                            class={`text-neo-green font-mono text-xs mb-1 opacity-50 ${skill.textHover}`}
                        >
                            {skill.category}
                        </div>
                        <div
                            class={`text-white font-black font-display text-xl uppercase text-center ${skill.textHover}`}
                        >
                            {skill.name}
                        </div>
                    </div>
                ))
            }
        </div>

        <div
            class="border-t-4 border-white mt-8 pt-4 flex justify-between font-mono text-xs text-gray-500"
        >
            <span>TOTAL_NODES: {skills.length}</span>
            <span>MEMORY_USAGE: 32GB RAM // CORE i5</span>
        </div>
    </div>
</section>
