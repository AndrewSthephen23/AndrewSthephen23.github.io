---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import ProjectCover from "./ProjectCover.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";

// Los proyectos se editan en src/data/projects.ts.
// Capturas reales (opcionales): archivos en src/assets/projects/ referenciados
// por nombre en el campo `image`. Sin captura, se dibuja una portada generada.
const captures = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/projects/*.{png,jpg,jpeg,webp,avif}",
    { eager: true },
);

function captureFor(file: string | undefined): ImageMetadata | undefined {
    if (!file) return undefined;
    const mod = captures[`/src/assets/projects/${file}`];
    if (!mod) {
        throw new Error(
            `[projects] No existe src/assets/projects/${file} (campo "image" en src/data/projects.ts).`,
        );
    }
    return mod.default;
}
---

<section
    id="projects"
    class="py-24 bg-primary border-t-4 border-ink px-4 overflow-hidden relative"
>
    <div class="max-w-7xl mx-auto">
        <h2
            class="text-6xl md:text-9xl font-black mb-16 uppercase tracking-tighter text-surface text-stroke-ink drop-shadow-[4px_4px_0_var(--t-shadow)]"
        >
            Selected Works
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            {
                projects.map((project, index) => {
                    const capture = captureFor(project.image);
                    return (
                    <article
                        class={`reveal group bg-panel border-4 border-ink p-4 shadow-hard ${index % 2 !== 0 ? "md:mt-20" : ""}`}
                    >
                        <div class="bg-box border-2 border-ink aspect-video relative overflow-hidden mb-6 group-hover:shadow-none transition-all">
                            <div
                                class="absolute top-2 left-2 bg-box text-box-ink px-2 py-1 font-mono text-xs border border-box-line z-10"
                                aria-hidden="true"
                            >
                                PROYECTO_0{index + 1}
                            </div>
                            {capture ? (
                                <Image
                                    src={capture}
                                    alt={project.imageAlt ?? `Captura de ${project.title}`}
                                    widths={[400, 800, 1200]}
                                    sizes="(max-width: 768px) 100vw, 600px"
                                    loading="lazy"
                                    class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity grayscale group-hover:grayscale-0 duration-500"
                                />
                            ) : (
                                <ProjectCover
                                    id={`p${index + 1}`}
                                    title={project.title}
                                    category={project.category}
                                    icon={project.icon}
                                    accent={project.accent}
                                    pattern={project.pattern}
                                />
                            )}
                        </div>

                        <div class="flex justify-between items-start">
                            <div class="min-w-0">
                                <h3
                                    class="text-2xl sm:text-4xl font-black uppercase mb-2 transition-colors glitch-hover wrap-break-word"
                                >
                                    {project.title}
                                </h3>
                                <p class="font-mono text-sm mb-4 max-w-xs text-muted">
                                    {project.description}
                                </p>

                                <div class="flex gap-2 font-mono text-xs font-bold flex-wrap">
                                    {project.tags.map((tag) => (
                                        <span class="bg-box text-box-ink px-2 py-1 border border-ink">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </div>

                            <a
                                href={project.link ?? site.github}
                                {...(project.link
                                    ? {}
                                    : { target: "_blank", rel: "noopener noreferrer" })}
                                aria-label={project.link ? `Ver ${project.title}` : `Ver ${project.title} en GitHub`}
                                class="w-12 h-12 flex-shrink-0 border-2 border-ink bg-success text-on-accent flex items-center justify-center hover:bg-box hover:text-box-ink transition-all cursor-hover shadow-hard-sm ml-4 mt-2"
                            >
                                <Icon name="ri:arrow-right-up-line" class="text-2xl" aria-hidden="true" />
                            </a>
                        </div>
                    </article>
                    );
                })
            }
        </div>

        <div class="text-center mt-24">
            <a
                href={site.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-box text-box-ink px-12 py-5 font-bold font-mono text-xl hover:bg-panel hover:text-ink border-4 border-ink transition-all shadow-hard hover:shadow-none cursor-hover"
            >
                VIEW ALL REPOS ON GITHUB
            </a>
        </div>
    </div>
</section>
