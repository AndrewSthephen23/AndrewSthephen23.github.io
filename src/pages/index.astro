---
import Layout from "../layouts/Layout.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import SelectedWorks from "../components/SelectedWorks.astro";
import UserReports from "../components/UserReports.astro";
import Contact from "../components/Contact.astro";
import { Icon } from "astro-icon/components";
import { site } from "../data/site";
---

<Layout title="Portafolio">
	<section
		class="min-h-screen flex flex-col justify-center items-center px-4 pt-20 relative overflow-hidden border-b-4 border-ink"
	>
		<div
			class="absolute top-1/3 left-[10%] w-16 h-16 bg-info border-4 border-ink shadow-hard animate-bounce hidden lg:block"
		>
		</div>
		<div
			class="absolute bottom-1/3 right-[10%] w-24 h-24 bg-secondary rounded-full border-4 border-ink shadow-hard hidden lg:block animate-pulse"
		>
		</div>

		<div
			class="absolute top-20 right-20 text-9xl opacity-5 font-black select-none pointer-events-none"
		>
			PWNED
		</div>

		<div class="relative z-10 text-center max-w-5xl">
			<div
				class="inline-block bg-panel border-2 border-ink px-4 py-1 mb-6 shadow-hard reveal"
			>
				<span
					class="font-mono font-bold text-success bg-box px-2 mr-2"
					>●</span
				>
				<span class="font-mono font-bold">SYSTEM STATUS: ONLINE</span>
			</div>

			<h1
				class="text-[13vw] md:text-[10vw] leading-[0.8] font-black uppercase tracking-tighter mb-6 reveal blend-darken"
			>
				PENTESTER<br />
				<span class="text-surface text-stroke-ink">JUNIOR</span>
			</h1>

			<p
				class="font-mono text-lg md:text-2xl max-w-2xl mx-auto mb-10 bg-primary text-on-accent border-2 border-ink p-4 shadow-hard reveal"
			>
				Rompiendo sistemas y documentando el proceso. <br />
				<b>Pentesting • Reverse Eng • Web Security</b>
			</p>

			<div class="flex flex-col md:flex-row justify-center gap-6 reveal">
				<a
					href="/blog"
					class="bg-box text-box-ink border-2 border-ink px-10 py-5 text-xl font-bold shadow-hard hover:bg-success hover:text-on-accent hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
				>
					VER WRITE-UPS
				</a>
				<a
					href="#skills"
					class="bg-panel text-ink border-2 border-ink px-10 py-5 text-xl font-bold shadow-hard hover:bg-secondary hover:text-on-accent hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover flex items-center justify-center gap-2"
				>
					<Icon name="ri:terminal-box-line" /> VER ARSENAL
				</a>
			</div>
		</div>
	</section>

	<div
		class="marquee-bar border-b-4 border-ink bg-info py-3 relative z-20 text-white"
	>
		<div class="marquee-container font-mono font-bold text-2xl">
			<div class="marquee-content">
				/// HACK THE BOX /// TRY HACK ME /// CAPTURE THE FLAG ///
				PENTESTER /// VULNERABILITY ASSESSMENT /// ENUMERATION ///
				SCANNING /// RED TEAM /// INFORMATION GATHERING /// EXPLOITATION
				/// POST-EXPLOITATION ///
			</div>
		</div>
	</div>

	<section
		id="about"
		class="py-24 px-4 max-w-7xl mx-auto border-x-4 border-ink bg-panel my-12 shadow-hard-lg"
	>
		<div class="grid grid-cols-1 md:grid-cols-12 gap-12">
			<div class="md:col-span-4 reveal">
				<div
					class="aspect-square bg-soft border-4 border-ink relative shadow-hard overflow-hidden group"
				>
					<div
						class="w-full h-full bg-box text-success flex items-center justify-center font-mono"
					>
						/NO_IMAGE_YET/
					</div>
					<span
						class="absolute top-2 left-2 bg-danger text-white px-2 font-mono text-xs border border-ink z-10"
						>ROOT.JPG</span
					>
				</div>
			</div>
			<div class="md:col-span-8 flex flex-col justify-center reveal">
				<h2 class="text-6xl font-black uppercase mb-6">Who am I?</h2>
				<p class="font-mono text-xl leading-relaxed mb-6">
					Soy un entusiasta de la ciberseguridad que cree que la web
					se ha vuelto demasiado aburrida. Traigo la <span
						class="bg-primary text-on-accent px-1 border border-ink"
						>estética cruda</span
					> de vuelta a mis reportes.
				</p>
				<p
					class="font-mono text-lg mb-8 text-muted border-l-4 border-special pl-4"
				>
					> Me considero un hacker ético en formación.<br />
					> Experiencia en plataformas como Hack The Box y TryHackMe.<br
					/>
					> Mi objetivo es documentar mi camino en la ciberseguridad de
					manera clara y divertida.
				</p>
				<div class="flex gap-4">
					{
						site.location && (
							<div class="bg-box text-box-ink px-4 py-2 font-mono text-sm border-2 border-transparent">
								📍 LOCATION: {site.location}
							</div>
						)
					}
					<div
						class="bg-success text-on-accent px-4 py-2 font-mono text-sm border-2 border-ink"
					>
						🟢 STATUS: AVAILABLE
					</div>
				</div>
			</div>
		</div>
	</section>

	<Skills />
	<Experience />
	<SelectedWorks />
	<UserReports />
	<Contact />
</Layout>
