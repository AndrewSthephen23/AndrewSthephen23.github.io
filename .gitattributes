# Normaliza finales de línea a LF en el repo y en el working tree,
# independientemente de core.autocrlf (el proyecto se edita en Windows).
* text=auto eol=lf

# Scripts de Windows sí necesitan CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binarios: sin conversión ni diff de texto
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.bmp   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.mp3   binary
*.pcap  binary
*.pcapng binary
