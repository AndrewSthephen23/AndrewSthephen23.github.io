---
import { Icon } from "astro-icon/components";
import { site, socials } from "../data/site";

// Email, ubicación y redes se editan en src/data/site.ts.
// Sin email: no hay enlace mailto ni formulario; se muestran las redes.
// Con email: el formulario compone un mailto: (sin backend ni servicios externos).
const { email, location, cv } = site;
---

<section id="contact" class="py-24 px-4 max-w-5xl mx-auto mb-20">
    <div
        class="bg-panel border-4 border-ink shadow-hard-xl p-8 md:p-12 relative reveal mt-12"
    >
        <div
            class="absolute -top-10 -left-6 bg-primary text-on-accent border-4 border-ink px-6 py-2 shadow-hard rotate-[-5deg]"
        >
            <span class="font-black text-2xl">INICIAR CONEXIÓN</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div>
                <h2 class="text-6xl font-black uppercase mb-6 leading-[0.85]">
                    Let's<br />Talk<br />Code.
                </h2>
                <p class="font-mono text-lg mb-8 text-muted">
                    Actualmente estoy disponible para colaboraciones, auditorías
                    de seguridad y desarrollo de proyectos.
                </p>
                <div class="space-y-4">
                    {
                        email && (
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 bg-box text-box-ink flex items-center justify-center border-2 border-ink">
                                    <Icon name="ri:mail-line" class="text-xl" aria-hidden="true" />
                                </div>
                                <a
                                    href={`mailto:${email}`}
                                    class="text-xl font-bold hover:bg-info hover:text-on-accent cursor-hover transition-colors break-all"
                                >
                                    {email}
                                </a>
                            </div>
                        )
                    }
                    {
                        location && (
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 bg-box text-box-ink flex items-center justify-center border-2 border-ink">
                                    <Icon name="ri:map-pin-line" class="text-xl" aria-hidden="true" />
                                </div>
                                <span class="text-xl font-bold">{location}</span>
                            </div>
                        )
                    }
                </div>
                {
                    cv && (
                        <a
                            href={cv}
                            download
                            class="mt-8 inline-flex items-center gap-3 bg-primary text-on-accent font-black text-lg px-6 py-3 border-2 border-ink shadow-hard hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                        >
                            <Icon name="ri:download-2-line" class="text-xl" aria-hidden="true" />
                            DESCARGAR CV
                            <span class="font-mono text-xs font-bold">[PDF]</span>
                        </a>
                    )
                }
            </div>

            {
                email ? (
                    <form
                        id="contact-form"
                        data-email={email}
                        class="space-y-6 bg-soft p-6 border-2 border-ink"
                    >
                        <div class="flex flex-col">
                            <label
                                for="contact-name"
                                class="font-mono font-bold mb-1 uppercase text-xs"
                            >
                                Identidad
                            </label>
                            <input
                                id="contact-name"
                                name="name"
                                type="text"
                                autocomplete="name"
                                placeholder="NOMBRE / ALIAS"
                                required
                                class="bg-panel border-2 border-ink p-3 font-bold placeholder:text-muted focus:placeholder:text-on-accent/75 focus:bg-primary focus:text-on-accent focus:shadow-hard-sm transition-all cursor-hover"
                            />
                        </div>

                        <div class="flex flex-col">
                            <label
                                for="contact-email"
                                class="font-mono font-bold mb-1 uppercase text-xs"
                            >
                                Coordenadas (Email)
                            </label>
                            <input
                                id="contact-email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                placeholder="CORREO ELECTRÓNICO"
                                required
                                class="bg-panel border-2 border-ink p-3 font-bold placeholder:text-muted focus:placeholder:text-on-accent/75 focus:bg-primary focus:text-on-accent focus:shadow-hard-sm transition-all cursor-hover"
                            />
                        </div>

                        <div class="flex flex-col">
                            <label
                                for="contact-message"
                                class="font-mono font-bold mb-1 uppercase text-xs"
                            >
                                Transmisión
                            </label>
                            <textarea
                                id="contact-message"
                                name="message"
                                rows="4"
                                placeholder="DETALLES DEL PROYECTO O VULNERABILIDAD..."
                                required
                                class="bg-panel border-2 border-ink p-3 font-bold placeholder:text-muted focus:placeholder:text-on-accent/75 focus:bg-primary focus:text-on-accent focus:shadow-hard-sm transition-all resize-none cursor-hover"
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="w-full bg-info text-on-accent font-black text-xl py-4 border-2 border-ink shadow-hard hover:bg-box hover:text-box-ink hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                        >
                            TRANSMIT DATA
                        </button>

                        <p
                            id="contact-status"
                            role="status"
                            hidden
                            class="flex items-start gap-2 bg-box text-box-ink border-2 border-ink p-3 font-mono text-sm"
                        >
                            <Icon
                                name="ri:checkbox-circle-fill"
                                class="text-xl text-success shrink-0"
                                aria-hidden="true"
                            />
                            <span>
                                Abriendo tu cliente de correo con el mensaje
                                listo. Si no se abre, escríbeme a{" "}
                                <a
                                    href={`mailto:${email}`}
                                    class="text-success font-bold underline cursor-hover break-all"
                                >
                                    {email}
                                </a>
                                .
                            </span>
                        </p>
                    </form>
                ) : (
                    <div class="bg-soft p-6 border-2 border-ink flex flex-col justify-center gap-4">
                        <p class="font-mono font-bold uppercase text-xs">
                            Canales abiertos
                        </p>
                        {socials.map((s) => (
                            <a
                                href={s.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex items-center justify-center gap-3 bg-box text-box-ink font-black text-xl py-4 border-2 border-ink shadow-hard hover:bg-primary hover:text-on-accent hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                            >
                                <Icon name={s.icon} aria-hidden="true" />
                                {s.label.toUpperCase()}
                            </a>
                        ))}
                        <a
                            href="/blog"
                            class="flex items-center justify-center gap-3 bg-panel text-ink font-black text-xl py-4 border-2 border-ink shadow-hard hover:bg-secondary hover:text-on-accent hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                        >
                            <Icon name="ri:article-line" aria-hidden="true" />
                            LEER EL BLOG
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</section>

<script>
    // Sin backend: compone un mailto: con asunto y cuerpo a partir del
    // formulario y deja visible el enlace directo por si no hay cliente de correo.
    const form = document.getElementById(
        "contact-form",
    ) as HTMLFormElement | null;
    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get("name") ?? "").trim();
        const from = String(data.get("email") ?? "").trim();
        const message = String(data.get("message") ?? "").trim();

        const subject = `Contacto desde el portafolio — ${name}`;
        const body = `${message}\n\n—\n${name}\n${from}`;
        const to = form.dataset.email ?? "";
        window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        document.getElementById("contact-status")?.removeAttribute("hidden");
    });
</script>
