---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { site } from "../data/site";
---

<Layout
    title="404 — Ruta no encontrada"
    description="La ruta que buscas no existe o se movió. Vuelve al portafolio o al blog de write-ups."
    noindex
>
    <section
        class="min-h-screen flex items-center justify-center px-4 pt-32 pb-24"
    >
        <div class="w-full max-w-3xl">
            <div
                class="bg-box text-box-ink border-4 border-ink shadow-hard-xl font-mono"
            >
                <div
                    class="flex items-center gap-2 border-b border-box-line px-4 py-2 text-sm"
                >
                    <span class="h-3 w-3 bg-danger border border-box-line"
                    ></span>
                    <span class="h-3 w-3 bg-warning border border-box-line"
                    ></span>
                    <span class="h-3 w-3 bg-success border border-box-line"
                    ></span>
                    <span class="ml-2 text-box-muted">error.log</span>
                </div>
                <div class="p-6 md:p-10">
                    <p class="text-sm md:text-base">
                        <span class="text-success">root@{site.alias.toLowerCase()}</span
                        >:<span class="text-info">~</span>$ cd
                        <span id="missing-path" class="break-all">ruta</span>
                    </p>
                    <p class="text-danger text-sm md:text-base mb-8">
                        bash: cd: No such file or directory
                    </p>

                    <h1
                        class="font-display text-[28vw] md:text-[12rem] leading-[0.8] font-black tracking-tighter glitch-hover cursor-hover inline-block"
                    >
                        404
                    </h1>
                    <p
                        class="font-display text-2xl md:text-4xl font-black uppercase mt-4"
                    >
                        Ruta no encontrada
                    </p>
                    <p class="text-box-muted mt-3 max-w-xl">
                        La página que buscas no existe, se movió o nunca pasó
                        del modo borrador.
                    </p>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-6 mt-10">
                <a
                    href="/"
                    class="flex items-center justify-center gap-2 bg-primary text-on-accent border-2 border-ink px-8 py-4 text-xl font-bold shadow-hard hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                >
                    <Icon name="ri:home-4-line" aria-hidden="true" /> cd /
                </a>
                <a
                    href="/blog"
                    class="flex items-center justify-center gap-2 bg-panel text-ink border-2 border-ink px-8 py-4 text-xl font-bold shadow-hard hover:bg-secondary hover:text-on-accent hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all cursor-hover"
                >
                    <Icon name="ri:article-line" aria-hidden="true" /> cd /blog
                </a>
            </div>
        </div>
    </section>
</Layout>

<script>
    // La 404 es estática: la ruta pedida solo se conoce en el navegador.
    const missing = document.getElementById("missing-path");
    if (missing) {
        try {
            missing.textContent = decodeURIComponent(location.pathname);
        } catch {
            missing.textContent = location.pathname;
        }
    }
</script>
