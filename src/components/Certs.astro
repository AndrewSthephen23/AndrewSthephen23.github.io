---
// Certs & Badges — certificaciones, badges y rankings desde src/data/certs.ts.
// Si el array está vacío, la sección no se renderiza (sin huecos ni relleno).
// Colores: SOLO utilidades semánticas del sistema de temas (docs/GUIA_TEMAS.md).
import { Icon } from "astro-icon/components";
import { certs, type CertType } from "../data/certs";

const TYPE_META: Record<CertType, { label: string; badge: string; icon: string }> = {
    cert: { label: "CERT", badge: "bg-success", icon: "ri:verified-badge-line" },
    badge: { label: "BADGE", badge: "bg-info", icon: "ri:medal-line" },
    ranking: { label: "RANKING", badge: "bg-warning", icon: "ri:trophy-line" },
    course: { label: "COURSE", badge: "bg-special", icon: "ri:award-line" },
};

/** "2026-03" → "MAR 2026"; "2026-03-15" → "15 MAR 2026". */
function formatCertDate(value: string): string {
    const [y, m, d] = value.split("-").map(Number);
    if (!y || !m) return value;
    const month = new Date(Date.UTC(y, m - 1, 1))
        .toLocaleDateString("es-ES", { month: "short", timeZone: "UTC" })
        .replace(".", "")
        .toUpperCase();
    return [d ? String(d).padStart(2, "0") : null, month, y]
        .filter(Boolean)
        .join(" ");
}

// Más recientes primero.
const items = [...certs].sort((a, b) => b.date.localeCompare(a.date));
---

{
    items.length > 0 && (
        <section
            id="certs"
            class="py-24 bg-box text-box-ink border-t-4 border-ink relative overflow-hidden"
            aria-labelledby="certs-title"
        >
            <div class="max-w-7xl mx-auto px-4">
                <div class="inline-flex items-center gap-4 mb-12 border-2 border-box-line p-4">
                    <span class="flex gap-2" aria-hidden="true">
                        <span class="h-3 w-3 rounded-full bg-danger" />
                        <span class="h-3 w-3 rounded-full bg-warning" />
                        <span class="h-3 w-3 rounded-full bg-success" />
                    </span>
                    <h2
                        id="certs-title"
                        class="font-mono text-xl md:text-2xl font-bold tracking-tighter"
                    >
                        CERTS_&amp;_BADGES<span class="text-success">.txt</span>
                    </h2>
                    <span class="font-mono text-xs text-box-muted">
                        [{items.length}]
                    </span>
                </div>

                <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
                    {items.map((c) => {
                        const meta = TYPE_META[c.type];
                        return (
                            <li class="border-2 border-box-line p-6 flex flex-col gap-4 hover:border-box-ink transition-colors">
                                <div class="flex items-center justify-between gap-2">
                                    <span
                                        class={`${meta.badge} text-on-accent px-2 py-0.5 font-mono text-xs font-black border border-ink`}
                                    >
                                        {meta.label}
                                    </span>
                                    <span class="font-mono text-xs text-box-muted">
                                        {formatCertDate(c.date)}
                                    </span>
                                </div>
                                <div class="flex items-start gap-3">
                                    <Icon
                                        name={meta.icon}
                                        class="text-3xl text-success shrink-0"
                                        aria-hidden="true"
                                    />
                                    <div>
                                        <h3 class="font-black text-xl leading-tight uppercase">
                                            {c.name}
                                        </h3>
                                        <p class="font-mono text-sm text-box-muted mt-1">
                                            {c.issuer}
                                        </p>
                                    </div>
                                </div>
                                {c.url && (
                                    <a
                                        href={c.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mt-auto inline-flex items-center gap-2 font-mono text-sm font-bold text-success underline underline-offset-4 hover:bg-success hover:text-on-accent cursor-hover self-start"
                                    >
                                        VERIFICAR
                                        <span class="sr-only">{c.name} (se abre en otra pestaña)</span>
                                        <Icon name="ri:external-link-line" aria-hidden="true" />
                                    </a>
                                )}
                            </li>
                        );
                    })}
                </ul>
            </div>
        </section>
    )
}
