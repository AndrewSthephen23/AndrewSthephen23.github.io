---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
    getPublishedPosts,
    getRelatedPosts,
    readingMinutes,
    formatDate,
    writeupMeta,
    CATEGORY_META,
    DIFFICULTY_META,
} from "../../lib/blog";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Callout from "../../components/mdx/Callout.astro";
import Terminal from "../../components/mdx/Terminal.astro";
import Flag from "../../components/mdx/Flag.astro";

export async function getStaticPaths() {
    const posts = await getPublishedPosts();
    return posts.map((post, i) => ({
        params: { slug: post.id },
        props: {
            post,
            prev: posts[i + 1] ?? null, // más antiguo
            next: posts[i - 1] ?? null, // más reciente
            related: getRelatedPosts(post, posts),
        },
    }));
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);

// Componentes disponibles en cualquier .mdx sin importarlos allí.
const mdxComponents = { Callout, Terminal, Flag };

const cat = CATEGORY_META[post.data.category];
const diff = post.data.difficulty
    ? DIFFICULTY_META[post.data.difficulty]
    : null;
const meta = writeupMeta(post.data);
const minutes = readingMinutes(post.body);

// Solo headings h2/h3 para la tabla de contenidos.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout
    title={post.data.title}
    description={post.data.description}
    image={post.data.image}
    imageAlt={post.data.title}
    type="article"
    publishedTime={post.data.pubDate}
    modifiedTime={post.data.updatedDate}
    tags={post.data.tags}
>
    <article class="pt-32 pb-24 px-4">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-12">
            <!-- ── Columna principal ── -->
            <div class="max-w-3xl min-w-0">
                <a
                    href="/blog"
                    class="inline-flex items-center gap-2 font-mono text-sm text-muted hover:text-ink hover:underline decoration-danger decoration-2 underline-offset-4 transition-colors mb-8 cursor-hover"
                >
                    <Icon name="ri:arrow-left-line" aria-hidden="true" /> cd ../blog
                </a>

                <div class="flex items-center gap-2 mb-6 flex-wrap">
                    <span
                        class={`${cat.badge} px-3 py-1 font-mono text-xs font-black border-2 border-ink`}
                    >
                        {cat.label}
                    </span>
                    {
                        diff && (
                            <span
                                class={`${diff.badge} px-3 py-1 font-mono text-xs font-black border-2 border-ink`}
                            >
                                {diff.label}
                            </span>
                        )
                    }
                    {
                        post.data.draft && (
                            <span class="bg-warning text-on-accent px-3 py-1 font-mono text-xs font-black border-2 border-ink">
                                DRAFT
                            </span>
                        )
                    }
                </div>

                <h1
                    class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-[0.95] mb-6"
                >
                    {post.data.title}
                </h1>

                <!-- Portada (opcional, optimizada con astro:assets) -->
                {
                    post.data.image && (
                        <Image
                            src={post.data.image}
                            alt={post.data.title}
                            widths={[480, 800, 1200]}
                            sizes="(max-width: 768px) 100vw, 768px"
                            class="w-full border-4 border-ink shadow-hard mb-10"
                            loading="eager"
                        />
                    )
                }

                <!-- Caja de metadatos tipo "reporte de pentest" -->
                <div
                    class="bg-box text-box-ink border-2 border-ink shadow-hard font-mono text-sm mb-10"
                >
                    <div
                        class="flex items-center gap-2 border-b border-box-line px-4 py-2"
                    >
                        <span class="h-3 w-3 rounded-full bg-danger" aria-hidden="true"></span>
                        <span class="h-3 w-3 rounded-full bg-warning" aria-hidden="true"></span>
                        <span class="h-3 w-3 rounded-full bg-success" aria-hidden="true"></span>
                        <span class="ml-2 text-box-muted">report_info.txt</span>
                    </div>
                    <dl class="p-4 space-y-1">
                        <div class="flex gap-3">
                            <dt class="text-success w-28 shrink-0">TARGET</dt>
                            <dd>{post.data.title}</dd>
                        </div>
                        {
                            meta && (
                                <div class="flex gap-3">
                                    <dt class="text-success w-28 shrink-0">
                                        SYSTEM
                                    </dt>
                                    <dd>{meta}</dd>
                                </div>
                            )
                        }
                        <div class="flex gap-3">
                            <dt class="text-success w-28 shrink-0">DATE</dt>
                            <dd>{formatDate(post.data.pubDate)}</dd>
                        </div>
                        <div class="flex gap-3">
                            <dt class="text-success w-28 shrink-0">READ_TIME</dt>
                            <dd>{minutes} min</dd>
                        </div>
                        {
                            post.data.tags.length > 0 && (
                                <div class="flex gap-3">
                                    <dt class="text-success w-28 shrink-0">
                                        TAGS
                                    </dt>
                                    <dd>{post.data.tags.join(", ")}</dd>
                                </div>
                            )
                        }
                    </dl>
                </div>

                <!-- TOC inline (solo móvil/tablet; en desktop va en el sidebar) -->
                {
                    toc.length > 0 && (
                        <nav
                            class="lg:hidden border-l-4 border-special pl-4 mb-10 font-mono text-sm"
                            aria-label="Tabla de contenidos"
                        >
                            <p class="font-bold text-muted mb-2 uppercase text-xs">
                                // Índice
                            </p>
                            <ul class="space-y-1">
                                {toc.map((h) => (
                                    <li class={h.depth === 3 ? "ml-4" : ""}>
                                        <a
                                            href={`#${h.slug}`}
                                            class="text-muted hover:text-ink hover:underline decoration-danger decoration-2 underline-offset-4 transition-colors cursor-hover"
                                        >
                                            {h.depth === 3 ? "└ " : ""}
                                            {h.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    )
                }

                <!-- Contenido del post -->
                <div class="prose-neo">
                    <Content components={mdxComponents} />
                </div>

                <!-- Posts relacionados -->
                {
                    related.length > 0 && (
                        <section class="mt-20 pt-10 border-t-4 border-ink">
                            <h2 class="text-2xl font-black uppercase mb-6 tracking-tight">
                                Related<span class="text-danger">_Logs</span>
                            </h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                {related.map((r) => {
                                    const rc = CATEGORY_META[r.data.category];
                                    return (
                                        <a
                                            href={`/blog/${r.id}/`}
                                            class="group bg-panel border-2 border-ink p-4 shadow-hard-sm hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all cursor-hover"
                                        >
                                            <span
                                                class={`${rc.badge} inline-block px-2 py-0.5 font-mono text-[10px] font-black border border-ink mb-2`}
                                            >
                                                {rc.label}
                                            </span>
                                            <div class="font-black uppercase leading-tight group-hover:underline decoration-danger decoration-2 underline-offset-4">
                                                {r.data.title}
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                        </section>
                    )
                }

                <!-- Navegación anterior/siguiente -->
                <nav
                    class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-12 pt-10 border-t-4 border-ink"
                >
                    {
                        prev ? (
                            <a
                                href={`/blog/${prev.id}/`}
                                class="group bg-panel border-2 border-ink p-4 shadow-hard-sm hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all cursor-hover"
                            >
                                <div class="font-mono text-xs text-muted mb-1">
                                    ← ANTERIOR
                                </div>
                                <div class="font-black uppercase group-hover:underline decoration-danger decoration-2 underline-offset-4">
                                    {prev.data.title}
                                </div>
                            </a>
                        ) : (
                            <div />
                        )
                    }
                    {
                        next && (
                            <a
                                href={`/blog/${next.id}/`}
                                class="group bg-panel border-2 border-ink p-4 shadow-hard-sm hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all cursor-hover text-right"
                            >
                                <div class="font-mono text-xs text-muted mb-1">
                                    SIGUIENTE →
                                </div>
                                <div class="font-black uppercase group-hover:underline decoration-danger decoration-2 underline-offset-4">
                                    {next.data.title}
                                </div>
                            </a>
                        )
                    }
                </nav>
            </div>

            <!-- ── Sidebar sticky: TOC (solo desktop) ── -->
            {
                toc.length > 0 && (
                    <aside class="hidden lg:block">
                        <nav
                            id="toc"
                            class="sticky top-28 font-mono text-sm border-l-4 border-special pl-4"
                            aria-label="Tabla de contenidos"
                        >
                            <p class="font-bold text-muted mb-3 uppercase text-xs">
                                // Índice
                            </p>
                            <ul class="space-y-2">
                                {toc.map((h) => (
                                    <li class={h.depth === 3 ? "ml-3" : ""}>
                                        <a
                                            href={`#${h.slug}`}
                                            data-toc-link={h.slug}
                                            class="toc-link text-muted hover:text-ink hover:underline decoration-danger decoration-2 underline-offset-4 transition-colors cursor-hover block"
                                        >
                                            {h.depth === 3 ? "└ " : ""}
                                            {h.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    </aside>
                )
            }
        </div>
    </article>
</Layout>

<style>
    /* Resaltado del heading activo: relleno primary + on-accent (AA en
       ambos temas; el rojo como texto pequeño sobre crema no llega). */
    .toc-link.is-current {
        background-color: var(--t-primary);
        color: var(--t-on-accent);
        font-weight: 700;
    }
</style>

<script>
    // ── Resaltado del heading activo en el TOC (scroll spy) ──
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
    if (tocLinks.length) {
        const headings = Array.from(tocLinks)
            .map((l) => document.getElementById(l.dataset.tocLink ?? ""))
            .filter((el): el is HTMLElement => el !== null);

        const spy = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    const id = entry.target.id;
                    tocLinks.forEach((l) =>
                        l.classList.toggle(
                            "is-current",
                            l.dataset.tocLink === id,
                        ),
                    );
                });
            },
            { rootMargin: "-96px 0px -70% 0px" },
        );
        headings.forEach((h) => spy.observe(h));
    }
</script>
